{
  "permissions": {
    "allow": [
      "Bash(make status)",
      "Bash(./scripts/status.sh)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git grep*)",
      "Bash(git fetch*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git remote -v)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr comment*)",
      "Bash(terraform*)",
      "Bash(kubectl*)",
      "Bash(aws*)",
      "mcp__*atlassian*__createJiraIssue",
      "mcp__*atlassian*__editJiraIssue",
      "mcp__*atlassian*__addCommentToJiraIssue",
      "mcp__*atlassian*__transitionJiraIssue",
      "mcp__*atlassian*__createIssueLink"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
